---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

// Exclude drafts in production; sort newest first.
const posts = (
	await getCollection("blog", ({ data }) => import.meta.env.DEV || !data.draft)
).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const dateFmt = new Intl.DateTimeFormat("en-US", { dateStyle: "long" });
---

<BaseLayout
	title="Blog — NicheHuntr"
	description="Field notes on niche research, demand signals, and building products people actually search for."
>
	<main class="mx-auto max-w-2xl px-6 py-16">
		<h1 class="text-4xl font-bold tracking-tight">Blog</h1>
		<p class="mt-3 text-muted-foreground">
			Field notes on niche research, demand signals, and shipping to under-served markets.
		</p>

		<ul class="mt-12 space-y-10">
			{
				posts.map((post) => (
					<li>
						<article>
							<time datetime={post.data.pubDate.toISOString()} class="text-sm text-muted-foreground">
								{dateFmt.format(post.data.pubDate)}
							</time>
							<h2 class="mt-1 text-xl font-semibold">
								<a href={`/blog/${post.id}/`} class="transition-colors hover:text-primary">
									{post.data.title}
								</a>
							</h2>
							<p class="mt-2 text-muted-foreground">{post.data.description}</p>
						</article>
					</li>
				))
			}
		</ul>
	</main>
</BaseLayout>
