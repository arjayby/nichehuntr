---
import { getCollection } from "astro:content";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { readingTime } from "../../lib/reading-time";

// Exclude drafts in production; sort newest first.
const posts = (
	await getCollection("blog", ({ data }) => import.meta.env.DEV || !data.draft)
).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const dateFmt = new Intl.DateTimeFormat("en-US", { dateStyle: "long" });
---

<BaseLayout
	title="Blog | NicheHuntr"
	description="Notes from the hunt: proof, timing, and duplication for Shorts creators who clone what works."
>
	<Header />

	<main class="mx-auto max-w-3xl px-6 py-20">
		<header class="max-w-2xl">
			<p class="text-sm text-primary">// blog</p>
			<h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">Notes from the hunt</h1>
			<p class="mt-4 text-lg text-muted-foreground">
				Practical writing for small creators: proof, timing, duplication, and cloning what
				already works.
			</p>
		</header>

		<ul class="mt-14 space-y-6">
			{
				posts.map((post) => (
					<li>
						<article class="group relative rounded-xl border border-border bg-card/50 p-6 transition-colors hover:border-primary/40 hover:bg-card">
							<div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-muted-foreground">
								<time datetime={post.data.pubDate.toISOString()}>
									{dateFmt.format(post.data.pubDate)}
								</time>
								<span aria-hidden="true">·</span>
								<span>{readingTime(post.body)} min read</span>
							</div>
							<h2 class="mt-3 text-xl font-semibold">
								<a href={`/blog/${post.id}/`} class="transition-colors group-hover:text-primary">
									{/* Stretched link: the whole card is clickable without nesting links. */}
									<span class="absolute inset-0" aria-hidden="true" />
									{post.data.title}
								</a>
							</h2>
							<p class="mt-2 leading-relaxed text-muted-foreground">{post.data.description}</p>
							{post.data.tags.length > 0 && (
								<div class="mt-4 flex flex-wrap gap-2">
									{post.data.tags.map((tag) => (
										<span class="rounded-full border border-primary/30 bg-primary/10 px-3 py-0.5 font-mono text-xs text-primary">
											{tag}
										</span>
									))}
								</div>
							)}
						</article>
					</li>
				))
			}
		</ul>
	</main>

	<Footer />
</BaseLayout>
