---
import ChannelCardMock from "../components/ChannelCardMock.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const APP_URL = "https://app.nichehuntr.com";

/*
 * Hero cards: one fictional channel per lifecycle stage, so the first viewport
 * teaches the product's core mental model (Emerging → Breaking Out →
 * Established) with the app's real card anatomy. The numbers obey the real
 * stage rules: Emerging clears the 50K bar but not 100K; Breaking Out clears
 * 100K before maturity; Established keeps that reach with 50K+ subscribers and
 * a deep catalog (and may not have uploaded this week — the rules allow it).
 */
const heroCards = [
	{
		stage: "emerging",
		card: {
			title: "Cursed Frequencies",
			handle: "cursedfrequencies",
			subscribers: "8.4K",
			recentChecked: 10,
			above100k: 2,
			above50k: 6,
			fetchedShorts: 34,
			latestShort: "Jul 6, 2026",
			// Freshly surfaced: the stage is already decided, the score is still
			// being computed. Channels appear before Clonability lands.
			clonability: null,
		},
	},
	{
		stage: "breaking out",
		card: {
			title: "Midnight Archives",
			handle: "midnightarchives",
			subscribers: "31K",
			recentChecked: 10,
			above100k: 7,
			above50k: 9,
			fetchedShorts: 46,
			latestShort: "Jul 8, 2026",
			clonability: 82,
		},
	},
	{
		stage: "established",
		card: {
			title: "Pocket Histories",
			handle: "pockethistories",
			subscribers: "214K",
			recentChecked: 10,
			above100k: 6,
			above50k: 8,
			fetchedShorts: 312,
			latestShort: "Jun 12, 2026",
			clonability: 45,
		},
	},
] as const;

const stages = [
	{
		name: "Emerging",
		verdict: "Early. Risky. First movers only.",
		body: "The latest Shorts are fresh and most of them already clear 50K views, but not the big bar yet. You could be first. You could also be early to a niche that never lands.",
		highlight: false,
	},
	{
		name: "Breaking Out",
		verdict: "The window. Clone now.",
		body: "Fresh uploads, and recent Shorts clearing 100K views each, before the channel has banked a big audience. Proof is in; the head start is not. This is the column the whole product exists to find.",
		highlight: true,
	},
	{
		name: "Established",
		verdict: "Proven. But you're late.",
		body: "Recent Shorts still clear 100K views, and the channel has already banked 50K+ subscribers and a deep catalog. The niche works. This channel proved it. Study the format; the easy entry was a year ago.",
		highlight: false,
	},
];

const faqs = [
	{
		q: "What exactly is NicheHuntr?",
		a: "A curated feed of short form YouTube channels that are provably working right now. Every channel is placed in one of three lifecycle columns by plain view count math, then scored for clonability, so you know whether the niche is worth entering today.",
	},
	{
		q: "Is cloning a niche actually okay?",
		a: "You clone the niche and the format, never the videos. Nobody owns a format. Every big niche on YouTube today started with someone copying a play that was already working and executing it better. The platform rewards it: duplicated niches are how the algorithm confirms demand.",
	},
	{
		q: "How does a channel qualify for the feed?",
		a: "Pure arithmetic on its latest ten Shorts. Enough of them clearing 50K views while uploads are fresh reads Emerging. Clearing 100K reads Breaking Out. Keep that 100K reach after banking 50K subscribers and a catalog of 50 Shorts and it reads Established. A channel that qualifies for none of the three stays tracked but hidden. Nothing fakes its way in.",
	},
	{
		q: "What if several channels run the same niche?",
		a: "They show up as separate cards, on purpose. One channel clearing the bar can be a personality. Three channels independently earning the same way is a market. We do not count competitors or score crowdedness. The duplication itself is the signal, and it is bullish.",
	},
	{
		q: "Why Shorts only?",
		a: "Because short form is the replicable game. Shorts run on repeatable formats, cheap production, and fast feedback, exactly the things a clone can copy. NicheHuntr tracks short form channels exclusively, so every number you see means what it should: 100K is always 100K views on a Short.",
	},
	{
		q: "Where do these channels come from?",
		a: "Hand picked, then machine graded. Our hunters submit candidate channels; the app pulls their live YouTube stats and the lifecycle math decides what appears and in which column. Nothing reaches the feed on anyone's word alone. The numbers have to agree.",
	},
	{
		q: "Is there a free plan?",
		a: "No. One plan, $20 a month, or $15 a month billed annually. If a single niche pick saves you one month of uploading into the void, it has paid for itself many times over. Cancel anytime.",
	},
];
---

<BaseLayout
	title="NicheHuntr | Find proven Shorts niches worth cloning"
	description="NicheHuntr is a curated feed of short form YouTube channels that are provably working right now: real views on recent Shorts, a clear lifecycle stage, and a clonability score with receipts."
>
	<Header />

	<!-- Hero: static text + a zero-JS product mockup built from real card anatomy. -->
	<section class="relative overflow-hidden border-b border-border/60">
		<div
			class="pointer-events-none absolute inset-0 -z-0 bg-[radial-gradient(ellipse_60%_50%_at_50%_-10%,--alpha(var(--color-primary)/12%),transparent)]"
		>
		</div>

		<div class="relative z-10 mx-auto max-w-6xl px-6 pt-24 sm:pt-32">
			<div class="mx-auto max-w-3xl text-center">
				<p
					class="mx-auto mb-6 inline-flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-4 py-1.5 text-xs text-primary"
				>
					<span class="relative flex h-2 w-2">
						<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-primary opacity-60"
						></span>
						<span class="relative inline-flex h-2 w-2 rounded-full bg-primary"></span>
					</span>
					// niche discovery for Shorts creators
				</p>
				<h1 class="text-balance text-4xl font-bold tracking-tight sm:text-6xl">
					Stop guessing niches. <span class="text-primary">Clone what already works.</span>
				</h1>
				<p class="mx-auto mt-6 max-w-2xl text-balance text-base text-muted-foreground sm:text-lg">
					You have uploaded for months and the algorithm gave you nothing. NicheHuntr is a curated
					feed of Shorts channels that are provably working right now: real views on recent
					uploads, a clear lifecycle stage, and room for one more channel. Yours.
				</p>
				<div class="mt-10 flex flex-wrap items-center justify-center gap-4">
					<a
						href={`${APP_URL}/signup`}
						class="rounded-md bg-primary px-6 py-3 font-medium text-primary-foreground shadow-lg shadow-primary/20 transition-colors hover:bg-primary/80"
					>
						Start hunting
					</a>
					<a
						href="#how-it-works"
						class="rounded-md border border-border bg-background/60 px-6 py-3 font-medium shadow-xs transition-colors hover:bg-muted"
					>
						See how it works
					</a>
				</div>
				<p class="mt-6 text-xs text-muted-foreground">$20 a month. No tiers. Cancel anytime.</p>
			</div>

			<!-- The feed, as it actually looks: one card per stage. -->
			<div class="mt-16 grid gap-4 pb-20 sm:pb-24 lg:grid-cols-3 lg:items-start">
				{
					heroCards.map(({ stage, card }) => (
						<div class:list={[stage === "breaking out" && "lg:-mt-4"]}>
							<p
								class:list={[
									"mb-2 text-center text-[10px] uppercase tracking-widest",
									stage === "breaking out" ? "text-primary" : "text-muted-foreground",
								]}
							>
								// {stage}
							</p>
							<ChannelCardMock
								{...card}
								class={
									stage === "breaking out"
										? "shadow-primary/10 shadow-xl ring-primary/60"
										: stage === "established"
											? "opacity-60"
											: ""
								}
							/>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- Everything below the hero is static, zero-JS .astro. -->
	<section id="how-it-works" class="scroll-mt-20">
		<div class="mx-auto max-w-6xl px-6 py-24">
			<div class="mx-auto max-w-2xl text-center">
				<p class="text-sm text-primary">// how it works</p>
				<h2 class="mt-3 text-balance text-3xl font-bold tracking-tight sm:text-4xl">
					Every niche has a window. We tell you where it is.
				</h2>
				<p class="mt-4 text-muted-foreground">
					Channels move left to right as they mature. Recent reach decides the column; nothing is
					assigned by hand. You want the middle one.
				</p>
			</div>

			<div class="mt-16 grid gap-6 lg:grid-cols-3">
				{
					stages.map((stage, i) => (
						<div
							class:list={[
								"relative rounded-xl border p-6",
								stage.highlight
									? "border-primary/60 bg-card shadow-xl shadow-primary/10"
									: "border-border bg-card/50",
							]}
						>
							<div class="flex items-center justify-between">
								<span
									class:list={[
										"text-xs tabular-nums",
										stage.highlight ? "text-primary" : "text-muted-foreground",
									]}
								>
									0{i + 1}
								</span>
								{stage.highlight && (
									<span class="rounded-full bg-primary px-3 py-0.5 text-xs font-semibold text-primary-foreground">
										clone here
									</span>
								)}
							</div>
							<h3 class="mt-4 text-xl font-bold">{stage.name}</h3>
							<p
								class:list={[
									"mt-1 text-sm font-medium",
									stage.highlight ? "text-primary" : "text-muted-foreground",
								]}
							>
								{stage.verdict}
							</p>
							<p class="mt-4 text-sm leading-relaxed text-muted-foreground">{stage.body}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section id="signals" class="scroll-mt-20 border-t border-border/60">
		<div class="mx-auto max-w-6xl px-6 py-24">
			<div class="mx-auto max-w-2xl text-center">
				<p class="text-sm text-primary">// the reads</p>
				<h2 class="mt-3 text-balance text-3xl font-bold tracking-tight sm:text-4xl">
					Two reads. One question: should you clone it?
				</h2>
				<p class="mt-4 text-muted-foreground">
					No keyword spreadsheets. No vibes. Every channel carries the same two reads, straight
					from the feed.
				</p>
			</div>

			<div class="mt-20 space-y-20">
				<!-- 1. Lifecycle evidence -->
				<div class="grid items-center gap-10 lg:grid-cols-2">
					<div>
						<h3 class="text-2xl font-bold tracking-tight">The stage is math</h3>
						<p class="mt-4 leading-relaxed text-muted-foreground">
							Subscriber counts lie. A single viral lies harder. A channel's column comes from
							counters anyone can check: how many of its latest ten Shorts already cleared 50K and
							100K views, how fresh the latest upload is, and how much audience the channel has
							banked. No AI, no weights, just arithmetic. Every card shows the evidence, so you
							can check the math yourself.
						</p>
					</div>
					<div class="rounded-xl border border-border bg-card p-6">
						<p class="text-xs text-muted-foreground">// latest 10 Shorts vs the 100K bar</p>
						<div class="relative mt-6 flex h-32 items-end gap-2">
							<div
								class="absolute inset-x-0 bottom-[55%] border-t border-dashed border-primary/60"
							>
								<span class="absolute -top-5 right-0 text-[10px] text-primary">100K views</span>
							</div>
							{
								[72, 61, 38, 78, 96, 22, 64, 85, 49, 70].map((h) => (
									<div
										class:list={[
											"flex-1 rounded-t-sm",
											h >= 55 ? "bg-primary/70" : "bg-muted-foreground/30",
										]}
										style={`height:${h}%`}
									/>
								))
							}
						</div>
						<div class="mt-4 flex items-center justify-between border-t border-border pt-3 text-xs">
							<span class="text-muted-foreground">Recent reach: 7/10 over 100K</span>
							<span class="rounded-full bg-primary px-2.5 py-0.5 font-semibold text-primary-foreground"
								>BREAKING OUT</span
							>
						</div>
					</div>
				</div>

				<!-- 2. Clonability -->
				<div class="grid items-center gap-10 lg:grid-cols-2">
					<div class="lg:order-2">
						<h3 class="text-2xl font-bold tracking-tight">A score with receipts</h3>
						<p class="mt-4 leading-relaxed text-muted-foreground">
							Once a channel is on the feed, an AI pass reads its recent titles and thumbnails and
							scores three signals. Automatable asks whether one editor can mass produce this from
							a template. Transformative asks whether it repackages existing material instead of
							creating from scratch. Improvable asks whether the incumbent is beatable while still
							winning. Each signal comes with a written rationale in the channel's detail view. Not
							just a number to sort by: the why, in one line each, so you can disagree with it. And
							it never decides the column. The math does.
						</p>
					</div>
					<div class="rounded-xl border border-border bg-card p-6 lg:order-1">
						<div class="flex items-baseline justify-between">
							<p class="text-xs text-muted-foreground">// clonability</p>
							<p class="text-4xl font-bold tabular-nums text-primary">82</p>
						</div>
						<div class="mt-4 space-y-2.5 border-t border-border pt-4">
							<div class="flex items-baseline gap-2 text-xs">
								<span class="w-24 shrink-0 font-medium">Automatable</span>
								<span class="shrink-0 tabular-nums text-muted-foreground">88</span>
								<span class="text-muted-foreground"
									>Faceless narration over AI stills. One editor can run it.</span
								>
							</div>
							<div class="flex items-baseline gap-2 text-xs">
								<span class="w-24 shrink-0 font-medium">Improvable</span>
								<span class="shrink-0 tabular-nums text-muted-foreground">79</span>
								<span class="text-muted-foreground"
									>Lazy thumbnails and flat pacing while the niche is still winning.</span
								>
							</div>
							<div class="flex items-baseline gap-2 text-xs">
								<span class="w-24 shrink-0 font-medium">Transformative</span>
								<span class="shrink-0 tabular-nums text-muted-foreground">74</span>
								<span class="text-muted-foreground"
									>Repackages public-domain archives with an endless backlog.</span
								>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Pricing: single plan, CSS-only monthly/annual toggle (checkbox + :has). -->
	<section id="pricing" class="group/pricing scroll-mt-20 border-t border-border/60">
		<div class="mx-auto max-w-6xl px-6 py-24">
			<div class="mx-auto max-w-2xl text-center">
				<p class="text-sm text-primary">// pricing</p>
				<h2 class="mt-3 text-balance text-3xl font-bold tracking-tight sm:text-4xl">
					One plan. Cheaper than another month of guessing.
				</h2>
				<p class="mt-4 text-muted-foreground">
					Every read, every column, the full feed. No tiers to decode, no features held hostage.
				</p>
			</div>

			<div class="mt-10 flex justify-center">
				<label
					class="flex cursor-pointer select-none items-center rounded-full border border-border p-1 text-xs has-[:focus-visible]:ring-3 has-[:focus-visible]:ring-ring/50"
				>
					<input type="checkbox" class="sr-only" aria-label="Bill annually" />
					<span
						class="rounded-full bg-primary px-4 py-1.5 font-medium text-primary-foreground group-has-[:checked]/pricing:bg-transparent group-has-[:checked]/pricing:font-normal group-has-[:checked]/pricing:text-muted-foreground"
					>
						Monthly
					</span>
					<span
						class="rounded-full px-4 py-1.5 text-muted-foreground group-has-[:checked]/pricing:bg-primary group-has-[:checked]/pricing:font-medium group-has-[:checked]/pricing:text-primary-foreground"
					>
						Annual · save 25%
					</span>
				</label>
			</div>

			<div class="mx-auto mt-10 max-w-md">
				<div class="relative rounded-xl border border-primary bg-card p-8 shadow-xl shadow-primary/10">
					<p
						class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-primary px-3 py-1 text-xs font-semibold text-primary-foreground"
					>
						Hunter
					</p>
					<p class="mt-2 flex items-baseline justify-center gap-1">
						<span class="text-5xl font-bold tracking-tight tabular-nums">
							<span class="group-has-[:checked]/pricing:hidden">$20</span>
							<span class="hidden group-has-[:checked]/pricing:inline">$15</span>
						</span>
						<span class="text-sm text-muted-foreground">per month</span>
					</p>
					<p class="mt-2 text-center text-xs text-muted-foreground">
						<span class="group-has-[:checked]/pricing:hidden">Billed monthly. Cancel anytime.</span>
						<span class="hidden group-has-[:checked]/pricing:inline"
							>$180 billed once a year. Cancel anytime.</span
						>
					</p>
					<ul class="mt-8 space-y-3 text-sm">
						{
							[
								"The full curated feed of Shorts channels",
								"All three lifecycle columns",
								"The evidence behind every stage, on every card",
								"Clonability scores with written rationales",
								"A private watchlist with folders",
								"Direct links to every channel on YouTube",
							].map((item) => (
								<li class="flex items-start gap-3">
									<svg
										xmlns="http://www.w3.org/2000/svg"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2.5"
										stroke-linecap="round"
										stroke-linejoin="round"
										class="mt-0.5 h-4 w-4 shrink-0 text-primary"
										aria-hidden="true"
									>
										<path d="M20 6L9 17l-5-5" />
									</svg>
									<span>{item}</span>
								</li>
							))
						}
					</ul>
					<a
						href={`${APP_URL}/signup`}
						class="mt-8 block rounded-md bg-primary px-6 py-3 text-center font-medium text-primary-foreground transition-colors hover:bg-primary/80"
					>
						Start hunting
					</a>
				</div>
			</div>
		</div>
	</section>

	<section id="faq" class="scroll-mt-20 border-t border-border/60">
		<div class="mx-auto max-w-3xl px-6 py-24">
			<div class="text-center">
				<p class="text-sm text-primary">// faq</p>
				<h2 class="mt-3 text-balance text-3xl font-bold tracking-tight sm:text-4xl">
					Questions creators actually ask
				</h2>
			</div>

			<!-- Native <details> keeps the accordion zero-JS and accessible. -->
			<div class="mt-12 space-y-3">
				{
					faqs.map((faq) => (
						<details class="group rounded-xl border border-border bg-card/50 open:bg-card">
							<summary class="flex cursor-pointer items-center justify-between gap-4 p-5 font-medium [&::-webkit-details-marker]:hidden">
								{faq.q}
								<svg
									xmlns="http://www.w3.org/2000/svg"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180"
									aria-hidden="true"
								>
									<path d="M6 9l6 6 6-6" />
								</svg>
							</summary>
							<p class="px-5 pb-5 text-sm leading-relaxed text-muted-foreground">{faq.a}</p>
						</details>
					))
				}
			</div>
		</div>
	</section>

	<section class="border-t border-border/60">
		<div class="mx-auto max-w-4xl px-6 py-24">
			<div
				class="relative overflow-hidden rounded-xl border border-primary/30 bg-gradient-to-br from-primary/15 via-card to-card px-8 py-16 text-center"
			>
				<h2 class="text-balance text-3xl font-bold tracking-tight sm:text-4xl">
					The next breakout niche is already on the feed.
				</h2>
				<p class="mx-auto mt-4 max-w-lg text-muted-foreground">
					Somewhere on YouTube right now, a small Shorts channel is quietly printing views in a
					niche with room for one more. Find it before the crowd does.
				</p>
				<a
					href={`${APP_URL}/signup`}
					class="mt-8 inline-block rounded-md bg-primary px-8 py-3 font-medium text-primary-foreground shadow-lg shadow-primary/20 transition-colors hover:bg-primary/80"
				>
					Start hunting
				</a>
				<p class="mt-4 text-xs text-muted-foreground">$20 a month · cancel anytime</p>
			</div>
		</div>
	</section>

	<Footer />
</BaseLayout>
