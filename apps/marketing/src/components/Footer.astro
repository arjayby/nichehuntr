---
const APP_URL = "https://app.nichehuntr.com";
const year = new Date().getFullYear();

const columns = [
	{
		heading: "Product",
		links: [
			{ href: "/#how-it-works", label: "How it works" },
			{ href: "/#signals", label: "Signals" },
			{ href: "/#pricing", label: "Pricing" },
			{ href: "/#faq", label: "FAQ" },
		],
	},
	{
		heading: "Resources",
		links: [
			{ href: "/blog/", label: "Blog" },
			{ href: "/rss.xml", label: "RSS feed" },
		],
	},
	{
		heading: "Account",
		links: [
			{ href: `${APP_URL}/login`, label: "Log in" },
			{ href: `${APP_URL}/signup`, label: "Start hunting" },
		],
	},
];
---

<footer class="border-t border-border/60">
	<div class="mx-auto max-w-6xl px-6 py-14">
		<div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-5">
			<div class="lg:col-span-2">
				<a href="/" class="text-lg font-bold tracking-tight">
					niche<span class="text-primary">huntr</span>
				</a>
				<p class="mt-3 max-w-xs text-sm text-muted-foreground">
					Proven niches, live momentum, and honest saturation counts for YouTube creators who clone
					what works.
				</p>
			</div>

			{
				columns.map((col) => (
					<div>
						<h3 class="text-sm font-semibold">{col.heading}</h3>
						<ul class="mt-4 space-y-3 text-sm">
							{col.links.map((link) => (
								<li>
									<a
										href={link.href}
										class="text-muted-foreground transition-colors hover:text-foreground"
									>
										{link.label}
									</a>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>

		<div
			class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-border/60 pt-8 text-sm text-muted-foreground sm:flex-row"
		>
			<p>&copy; {year} NicheHuntr. All rights reserved.</p>
			<p class="text-xs">Built for creators in the trenches.</p>
		</div>
	</div>
</footer>
