---
/**
 * Static, zero-JS replica of the app's ChannelCard (apps/web channel-card.tsx).
 * The landing page shows real product anatomy — avatar, subscribers, the
 * recent-reach read (x/y of the latest Shorts over 100K), fetched-Shorts count,
 * latest-Short date, the 50K+ row, Clonability, top-2 signal scores — with
 * handcrafted fictional data, so the mockup never goes stale or names a real
 * channel as a clone target.
 */
interface Signal {
	label: string;
	score: number;
}

interface Props {
	title: string;
	handle: string;
	/** Display strings, pre-formatted like the app's compact formatter. */
	subscribers: string;
	/** Recent reach: of `recentChecked` latest Shorts, how many cleared each bar. */
	recentChecked: number;
	above100k: number;
	above50k: number;
	fetchedShorts: number;
	/** Pre-formatted publish date of the latest Short, e.g. "Jul 8, 2026". */
	latestShort: string;
	/** null renders the app's pending "—": the Channel appears before it is scored. */
	clonability: number | null;
	/** Top-2 signals, label + score only — rationales live in the detail view. */
	signals?: readonly Signal[];
	class?: string;
}

const {
	title,
	handle,
	subscribers,
	recentChecked,
	above100k,
	above50k,
	fetchedShorts,
	latestShort,
	clonability,
	signals = [],
	class: className = "",
} = Astro.props;

const initials = title
	.split(/\s+/)
	.filter(Boolean)
	.slice(0, 2)
	.map((word) => word[0]?.toUpperCase() ?? "")
	.join("");
---

<!-- Shell mirrors the app's stock Card (size sm): ring chrome, not a border. -->
<div
	class:list={["rounded-xl bg-card p-4 text-left shadow-xs ring-1 ring-foreground/10", className]}
>
	<div class="flex items-center gap-3">
		<div
			class="flex size-10 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium text-muted-foreground"
		>
			{initials}
		</div>
		<div class="min-w-0">
			<p class="truncate text-sm font-medium">{title}</p>
			<p class="truncate text-xs text-muted-foreground">@{handle}</p>
		</div>
		<div class="ml-auto flex shrink-0 flex-col items-end gap-1">
			<div class="flex items-center gap-1 text-muted-foreground">
				<!-- Save-to-Watchlist and open-on-YouTube affordances, as in the app. -->
				<svg
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="size-4"
					aria-hidden="true"><path d="M19 21l-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg
				>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="size-4"
					aria-hidden="true"
					><path d="M15 3h6v6M10 14L21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
					></path></svg
				>
			</div>
			<div class="text-right">
				<div class="text-xs text-muted-foreground">Clonability</div>
				<div class="text-lg font-semibold tabular-nums">{clonability ?? "—"}</div>
			</div>
		</div>
	</div>

	<div class="mt-4 grid grid-cols-2 gap-3">
		<div>
			<div class="text-xs text-muted-foreground">Subscribers</div>
			<div class="text-lg font-semibold tabular-nums">{subscribers}</div>
		</div>
		<div class="text-right">
			<div class="text-xs text-muted-foreground">Recent reach</div>
			<div class="text-lg font-semibold tabular-nums">{above100k}/{recentChecked}</div>
			<div class="text-[11px] text-muted-foreground">100K+ Shorts</div>
		</div>
		<div class="flex items-center gap-1.5 text-xs text-muted-foreground">
			<svg
				xmlns="http://www.w3.org/2000/svg"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				class="size-3.5"
				aria-hidden="true"
				><path d="m16 13 5.223 3.482a.5.5 0 0 0 .777-.416V7.87a.5.5 0 0 0-.752-.432L16 10.5"
				></path><rect x="2" y="6" width="14" height="12" rx="2"></rect></svg
			>
			<span class="tabular-nums">{fetchedShorts} Shorts fetched</span>
		</div>
		<div class="flex items-center justify-end gap-1.5 text-xs text-muted-foreground">
			<svg
				xmlns="http://www.w3.org/2000/svg"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				class="size-3.5"
				aria-hidden="true"
				><path d="M8 2v4M16 2v4"></path><rect x="3" y="4" width="18" height="18" rx="2"></rect><path
					d="M3 10h18M16 14l-2.26 2.26a.3.3 0 0 0 0 .43L16 19"></path></svg
			>
			<span class="truncate">{latestShort}</span>
		</div>
		<div
			class="col-span-2 flex items-center justify-between rounded-md bg-muted/60 px-2 py-1 text-xs"
		>
			<span class="text-muted-foreground">50K+ Shorts</span>
			<span class="font-medium tabular-nums">{above50k}/{recentChecked}</span>
		</div>
	</div>

	{
		signals.length > 0 && (
			<div class="mt-3 grid grid-cols-2 gap-x-3 gap-y-1 border-t border-border pt-2">
				{signals.map((signal) => (
					<div class="flex min-w-0 items-baseline gap-1.5 text-xs">
						<span class="truncate font-medium text-foreground">{signal.label}</span>
						<span class="shrink-0 tabular-nums text-muted-foreground">{signal.score}</span>
					</div>
				))}
			</div>
		)
	}
</div>
