---
/**
 * Static, zero-JS replica of the app's ChannelCard (apps/web channel-card.tsx).
 * The landing page shows real product anatomy — avatar, subscribers, the
 * recent-reach read (x/y of the latest Shorts over 100K), Clonability as the
 * third stat, fetched-Shorts count, latest-Short date, and the 50K+ row — with
 * handcrafted fictional data, so the mockup never goes stale or names a real
 * channel as a clone target. As in the app, the per-signal scores live behind
 * the Clonability number (a hover in the app) rather than on the card face; the
 * dashed underline marks the number as inspectable.
 */
interface Props {
	title: string;
	handle: string;
	/** Display strings, pre-formatted like the app's compact formatter. */
	subscribers: string;
	/** Recent reach: of `recentChecked` latest Shorts, how many cleared each bar. */
	recentChecked: number;
	above100k: number;
	above50k: number;
	fetchedShorts: number;
	/** Pre-formatted publish date of the latest Short, e.g. "Jul 8, 2026". */
	latestShort: string;
	/** null renders the app's pending "—": the Channel appears before it is scored. */
	clonability: number | null;
	class?: string;
}

const {
	title,
	handle,
	subscribers,
	recentChecked,
	above100k,
	above50k,
	fetchedShorts,
	latestShort,
	clonability,
	class: className = "",
} = Astro.props;

const initials = title
	.split(/\s+/)
	.filter(Boolean)
	.slice(0, 2)
	.map((word) => word[0]?.toUpperCase() ?? "")
	.join("");
---

<!-- Shell mirrors the app's stock Card (size sm): ring chrome, not a border. -->
<div
	class:list={["rounded-xl bg-card p-4 text-left shadow-xs ring-1 ring-foreground/10", className]}
>
	<!-- min-w-0 so long titles truncate instead of overflowing, as in the app. -->
	<div class="flex min-w-0 items-center gap-3">
		<div
			class="flex size-10 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium text-muted-foreground"
		>
			{initials}
		</div>
		<div class="min-w-0">
			<p class="truncate text-sm font-medium">{title}</p>
			<p class="truncate text-xs text-muted-foreground">@{handle}</p>
		</div>
		<!-- Save-to-Watchlist and open-on-YouTube affordances, as in the app. -->
		<div class="ml-auto flex shrink-0 items-center gap-1 text-muted-foreground">
			<svg
				xmlns="http://www.w3.org/2000/svg"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				class="size-4"
				aria-hidden="true"><path d="M19 21l-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg
			>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				class="size-4"
				aria-hidden="true"
				><path d="M15 3h6v6M10 14L21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
				></path></svg
			>
		</div>
	</div>

	<div class="mt-4 flex flex-col gap-3">
		<!-- Three-stat row, mirroring the app's evidence read and detail modal. -->
		<div class="flex items-end justify-between gap-2">
			<div>
				<div class="text-[11px] text-muted-foreground">Subscribers</div>
				<div class="text-lg font-semibold tabular-nums">{subscribers}</div>
			</div>
			<div class="text-center">
				<div class="whitespace-nowrap text-[11px] text-muted-foreground">Recent reach</div>
				<div class="text-lg font-semibold tabular-nums">{above100k}/{recentChecked}</div>
				<div class="whitespace-nowrap text-[10px] text-muted-foreground">100K+ Shorts</div>
			</div>
			<div class="text-right">
				<div class="text-[11px] text-muted-foreground">Clonability</div>
				<!-- Dashed underline marks the number as inspectable (a hover in the app). -->
				<div
					class="text-lg font-semibold tabular-nums underline decoration-dashed decoration-muted-foreground underline-offset-4"
				>
					{clonability ?? "—"}
				</div>
			</div>
		</div>

		<div class="flex items-center justify-between gap-2">
			<div class="flex items-center gap-1.5 text-[11px] text-muted-foreground">
				<svg
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="size-3.5"
					aria-hidden="true"
					><path d="m16 13 5.223 3.482a.5.5 0 0 0 .777-.416V7.87a.5.5 0 0 0-.752-.432L16 10.5"
					></path><rect x="2" y="6" width="14" height="12" rx="2"></rect></svg
				>
				<span class="whitespace-nowrap tabular-nums">{fetchedShorts} Shorts fetched</span>
			</div>
			<div class="flex min-w-0 items-center gap-1.5 text-[11px] text-muted-foreground">
				<svg
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="size-3.5"
					aria-hidden="true"
					><path d="M8 2v4M16 2v4"></path><rect x="3" y="4" width="18" height="18" rx="2"></rect><path
						d="M3 10h18M16 14l-2.26 2.26a.3.3 0 0 0 0 .43L16 19"></path></svg
				>
				<span class="truncate">{latestShort}</span>
			</div>
		</div>

		<div
			class="flex items-center justify-between rounded-md bg-muted/60 px-2 py-1 text-xs"
		>
			<span class="text-muted-foreground">50K+ Shorts</span>
			<span class="font-medium tabular-nums">{above50k}/{recentChecked}</span>
		</div>
	</div>
</div>
