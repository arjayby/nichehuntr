---
// App lives on the subdomain; every CTA is a plain cross-origin link (the
// marketing site is fully decoupled — no auth/Convex client).
const APP_URL = "https://app.nichehuntr.com";

// Section anchors resolve against the landing page so they work from /blog too.
const navLinks = [
	{ href: "/#how-it-works", label: "How it works" },
	{ href: "/#signals", label: "Signals" },
	{ href: "/#pricing", label: "Pricing" },
	{ href: "/#faq", label: "FAQ" },
	{ href: "/blog/", label: "Blog" },
];
---

<header class="sticky top-0 z-50 border-b border-border/60 bg-background/80 backdrop-blur">
	<nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
		<a href="/" class="text-lg font-bold tracking-tight">
			niche<span class="text-primary">huntr</span>
		</a>

		<div class="hidden items-center gap-7 text-sm md:flex">
			{
				navLinks.map((link) => (
					<a href={link.href} class="text-muted-foreground transition-colors hover:text-foreground">
						{link.label}
					</a>
				))
			}
		</div>

		<div class="flex items-center gap-4 text-sm">
			<a
				href={`${APP_URL}/login`}
				class="hidden text-muted-foreground transition-colors hover:text-foreground sm:block"
			>
				Log in
			</a>
			<a
				href={`${APP_URL}/signup`}
				class="rounded-md bg-primary px-4 py-2 font-medium text-primary-foreground transition-opacity hover:opacity-90"
			>
				Start hunting
			</a>
		</div>
	</nav>
</header>
