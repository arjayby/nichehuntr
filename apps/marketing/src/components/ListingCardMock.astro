---
/**
 * Static, zero-JS replica of the app's ListingCard (apps/web listing-card.tsx).
 * The landing page shows real product anatomy — avatar, form badge, momentum
 * pill, median views, saturation read, clonability, signal rationales — with
 * handcrafted fictional data, so the mockup never goes stale or names a real
 * channel as a clone target.
 */
interface Signal {
	label: string;
	score: number;
	rationale: string;
}

interface Props {
	title: string;
	handle: string;
	form: "long" | "short";
	/** Display string, e.g. "+34%/d". */
	momentum: string;
	/** strong → filled brand pill, up → plain trending, flat → muted dash. */
	momentumTone: "strong" | "up" | "flat";
	medianViews: string;
	saturation: number;
	/** high → destructive read (crowded niche). */
	saturationHigh?: boolean;
	clonability: number;
	signals?: readonly Signal[];
	class?: string;
}

const {
	title,
	handle,
	form,
	momentum,
	momentumTone,
	medianViews,
	saturation,
	saturationHigh = false,
	clonability,
	signals = [],
	class: className = "",
} = Astro.props;

const initials = title
	.split(/\s+/)
	.filter(Boolean)
	.slice(0, 2)
	.map((word) => word[0]?.toUpperCase() ?? "")
	.join("");
---

<div class:list={["rounded-xl border border-border bg-card p-4 text-left shadow-sm", className]}>
	<div class="flex items-center gap-3">
		<div
			class="flex size-10 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium text-muted-foreground"
		>
			{initials}
		</div>
		<div class="min-w-0">
			<p class="truncate text-sm font-semibold leading-tight">{title}</p>
			<p class="truncate text-xs text-muted-foreground">@{handle}</p>
		</div>
		<div class="ml-auto flex shrink-0 flex-col items-end gap-1">
			<span
				class="rounded-full bg-secondary px-2 py-0.5 text-[10px] font-medium uppercase text-secondary-foreground"
			>
				{form}
			</span>
			{
				momentumTone === "strong" ? (
					<span class="inline-flex items-center gap-1 rounded-full bg-primary px-2 py-0.5 text-xs font-medium tabular-nums text-primary-foreground">
						<svg
							xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							class="size-3"
							aria-hidden="true"
						>
							<path d="M22 7l-8.5 8.5-5-5L2 17M16 7h6v6" />
						</svg>
						{momentum}
					</span>
				) : (
					<span
						class:list={[
							"inline-flex items-center gap-1 text-xs font-medium tabular-nums",
							momentumTone === "up" ? "text-foreground" : "text-muted-foreground",
						]}
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							class="size-3.5"
							aria-hidden="true"
						>
							{momentumTone === "up" ? <path d="M22 7l-8.5 8.5-5-5L2 17M16 7h6v6" /> : <path d="M5 12h14" />}
						</svg>
						{momentum}
					</span>
				)
			}
		</div>
	</div>

	<div class="mt-4 flex items-end justify-between gap-3">
		<div>
			<div class="text-xs text-muted-foreground">Median views</div>
			<div class="text-lg font-semibold tabular-nums">{medianViews}</div>
		</div>
		<div class="text-center">
			<div class="text-xs text-muted-foreground">Niche</div>
			<div
				class:list={[
					"inline-flex items-center gap-1 text-sm font-medium tabular-nums",
					saturationHigh ? "text-destructive" : "text-muted-foreground",
				]}
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="size-3.5"
					aria-hidden="true"
				>
					<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
					<circle cx="9" cy="7" r="4" />
					<path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
				</svg>
				{saturation}
			</div>
		</div>
		<div class="text-right">
			<div class="text-xs text-muted-foreground">Clonability</div>
			<div class="text-lg font-semibold tabular-nums">{clonability}</div>
		</div>
	</div>

	{
		signals.length > 0 && (
			<div class="mt-3 flex flex-col gap-1 border-t border-border pt-2">
				{signals.map((signal) => (
					<div class="flex items-baseline gap-1.5 text-xs">
						<span class="shrink-0 font-medium text-foreground">{signal.label}</span>
						<span class="shrink-0 tabular-nums text-muted-foreground">{signal.score}</span>
						<span class="truncate text-muted-foreground">{signal.rationale}</span>
					</div>
				))}
			</div>
		)
	}
</div>
